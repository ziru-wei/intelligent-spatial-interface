.DS_Store
**/__pycache__/
**/.venv/
**/.venv-mesh/
**/node_modules/
**/sessions/
# The scene data (editor/spaces) is synced, but not its 3D models, nor the home scene (needed here only), nor the camera frames of recordings the Gallery does not use
editor/spaces/home/
editor/spaces/**/*.glb
editor/spaces/*/scenarios/*/frames/
!editor/spaces/atlas/scenarios/atlas_rec_1/frames/
!editor/spaces/atlas/scenarios/atlas_rec_2/frames/
!editor/spaces/atlas/scenarios/atlas_rec_3/frames/
!editor/spaces/atlas/scenarios/atlas_rec_4/frames/
!editor/spaces/atlas/scenarios/atlas_rec_5/frames/
**/exports/
**/private/
*.mp4
*.log

# Local TypeSafe and Gemini credentials (never commit).
editor/agent-config.local.json

# Rebuildable per-recording offline hand masks
**/.hand-cache/

# Vision Pro app (visionos/): the space data is exported from editor/spaces (private), so regenerate it with visionos/tools
visionos/SpaceData/
visionos/**/xcuserdata/
visionos/**/*.xcuserstate
