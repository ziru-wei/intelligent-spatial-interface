{
  "id": "worldinfo",
  "name": "WorldInfo",
  "description": "Answer about a thing or a place the user is asking about, from the information attached to it.",
  "examples": [
    "Can I eat this?",
    "What is this?",
    "What are the rules here?"
  ],
  "scope": "referent",
  "knowledge": [
    {
      "ref": "referent"
    }
  ],
  "selectors": {},
  "slots": [
    {
      "id": "answer",
      "use": "situated-text",
      "anchor": {
        "kind": "object",
        "of": "referent"
      },
      "ui": {
        "fixed": [
          "floatingText"
        ],
        "flexible": [
          {
            "cue": "embeddedText",
            "when": "surface.score>=0.5",
            "instead_of": "floatingText"
          },
          {
            "cue": "textArrow",
            "when": "text.apart"
          }
        ]
      }
    },
    {
      "id": "voice",
      "use": "ego-object",
      "anchor": {
        "kind": "object",
        "of": "referent"
      },
      "ui": {
        "flexible": [
          {
            "cue": "dialogue",
            "when": "target.pointed & request.second_person"
          },
          {
            "cue": "asset:ego-motion",
            "when": "target.pointed & request.second_person"
          }
        ]
      }
    }
  ],
  "provider": "system",
  "text": "answer"
}
