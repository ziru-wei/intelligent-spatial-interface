{
  "version": 1,
  "note": "Core primitive representations (modos-system-design.md section 4). Fixed by the authors; users compose them into MODs but do not add new ones. Every param is bounded: enum, pick-one, pick-many (Jev decides), derived (a rule decides) or setting (the author decides once, when tailoring a MOD; never asked at runtime). Generated text is not a param.",
  "item_types": [
    "text",
    "file",
    "steps",
    "timeseries",
    "schedule",
    "item-location",
    "status",
    "device-state"
  ],
  "anchor_kinds": [
    "object",
    "surface",
    "place",
    "door",
    "user-view",
    "user-reach",
    "user-body",
    "relative"
  ],
  "primitives": [
    {
      "id": "highlight",
      "description": "Highlight objects or containers; a nested container also glows its parent faintly.",
      "accepts": [
        "item-location",
        "status",
        "entity"
      ],
      "anchors": [
        "object"
      ],
      "params": {
        "targets": {
          "kind": "pick-many",
          "from": "entities"
        },
        "tone": {
          "kind": "enum",
          "values": [
            "neutral",
            "attention",
            "warning"
          ]
        },
        "dismiss": {
          "kind": "setting",
          "values": [
            "never",
            "hand-approach"
          ],
          "default": "never"
        }
      }
    },
    {
      "id": "ego-object",
      "description": "An object speaks in the first person (the answer text, in its voice) and makes a small motion.",
      "accepts": [
        "text",
        "file",
        "status"
      ],
      "anchors": [
        "object"
      ],
      "params": {
        "speaker": {
          "kind": "pick-one",
          "from": "entities"
        },
        "effect": {
          "kind": "enum",
          "values": [
            "bounce",
            "grow",
            "color"
          ]
        },
        "tone": {
          "kind": "enum",
          "values": [
            "neutral",
            "attention",
            "warning"
          ]
        },
        "dismiss": {
          "kind": "setting",
          "values": [
            "never",
            "hand-touch"
          ],
          "default": "never"
        }
      }
    },
    {
      "id": "situated-text",
      "description": "The answer text placed next to an entity, on a surface, relative to another slot, or in the user's view; can point at its referent with corners and an arrow.",
      "accepts": [
        "any"
      ],
      "anchors": [
        "object",
        "surface",
        "relative",
        "user-view"
      ],
      "params": {
        "link": {
          "kind": "derived",
          "rule": "true when the text is about the referent"
        },
        "duration": {
          "kind": "setting",
          "values": [
            "stay",
            "5s"
          ],
          "default": "stay"
        }
      }
    },
    {
      "id": "label",
      "description": "Short tags, door signs and annotations.",
      "accepts": [
        "text",
        "steps"
      ],
      "anchors": [
        "object",
        "door",
        "place",
        "user-body"
      ],
      "params": {
        "targets": {
          "kind": "pick-many",
          "from": "entities"
        }
      }
    },
    {
      "id": "data-widget",
      "description": "An operable data panel: day buttons, a timeline, play and pause, readouts, or a list.",
      "accepts": [
        "timeseries",
        "schedule",
        "steps"
      ],
      "anchors": [
        "user-reach",
        "surface"
      ],
      "params": {
        "layout": {
          "kind": "derived",
          "rule": "several days -> day-buttons; several periods in one day -> timeline; one instant -> single; schedule or steps -> list"
        }
      },
      "state": {
        "emits": [
          "cursor",
          "playing"
        ]
      }
    },
    {
      "id": "ambient-effect",
      "description": "A data-driven effect blended into the environment (sky, sun and moon, rain and snow, light), composited on a window, wall, desk or ceiling.",
      "accepts": [
        "timeseries"
      ],
      "anchors": [
        "surface"
      ],
      "params": {
        "effect": {
          "kind": "derived",
          "rule": "from the condition of the current entry"
        },
        "lock": {
          "kind": "setting",
          "values": [
            "follow",
            "lock"
          ],
          "default": "follow"
        }
      },
      "state": {
        "reads": [
          "cursor"
        ]
      }
    },
    {
      "id": "control",
      "description": "Switches and sliders next to a connected device.",
      "accepts": [
        "device-state"
      ],
      "anchors": [
        "object"
      ],
      "params": {
        "device": {
          "kind": "pick-one",
          "from": "entities"
        },
        "actions": {
          "kind": "pick-many",
          "from": "data"
        }
      }
    },
    {
      "id": "scene-asset",
      "description": "A prefabricated animation, model or image played at a place or on a surface.",
      "accepts": [
        "asset"
      ],
      "anchors": [
        "object",
        "place",
        "surface"
      ],
      "params": {
        "asset": {
          "kind": "pick-one",
          "from": "allowed"
        }
      }
    },
    {
      "id": "guidance",
      "description": "A direction cue when the target is out of view, a heading toward another place, or an arrow on the body showing how to move.",
      "accepts": [
        "entity",
        "steps"
      ],
      "anchors": [
        "user-view",
        "door",
        "user-body"
      ],
      "params": {
        "target": {
          "kind": "derived",
          "rule": "the target the MOD selected"
        }
      },
      "state": {
        "reads": [
          "target-visible",
          "body-pose"
        ]
      }
    },
    {
      "id": "action-card",
      "description": "A pending action the user confirms: what will be done, for whom and with what, an editable draft, and a confirm button (the action runs only when it is pressed).",
      "accepts": [
        "text",
        "file",
        "contacts"
      ],
      "anchors": [
        "object",
        "user-reach"
      ],
      "params": {}
    }
  ]
}